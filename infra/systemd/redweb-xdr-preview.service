[Unit]
Description=REDWEB XDR Correlator Preview (DRY-RUN)
After=wazuh-manager.service
RequiresMountsFor=/var/ossec/logs/alerts /var/lib/redweb-xdr

[Service]
Type=simple
User=root
WorkingDirectory=/opt/redweb-xdr
ExecStart=/usr/bin/python3 -u /opt/redweb-xdr/live_correlator.py --watch

Restart=on-failure
RestartSec=5
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/redweb-xdr
ReadOnlyPaths=/var/ossec/logs/alerts
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
