logging {
  level = "info"
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}

loki.source.file "tomcat_access" {
  targets = [
    {
      __path__ = "/var/log/tomcat/localhost_access_log.*.txt",
      job      = "tomcat_access",
      server   = "redweb-cloudv",
    },
  ]

  forward_to = [loki.process.webapp_label.receiver]

  tail_from_end = true

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

loki.process "webapp_label" {
  stage.regex {
    expression = `"[A-Z]+ /(?P<app>scuredweb|redweb)(?:[/? ]|$)`
  }

  stage.labels {
    values = {
      app = "app",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.source.file "tomcat_runtime" {
  targets = [
    {
      __path__ = "/var/log/tomcat/catalina.*.log",
      job      = "tomcat_runtime",
      log_type = "catalina",
    },
    {
      __path__ = "/var/log/tomcat/localhost.*.log",
      job      = "tomcat_runtime",
      log_type = "localhost",
    },
  ]

  forward_to = [loki.write.local.receiver]

  tail_from_end = true

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}


// Wazuh Manager security alerts
loki.source.file "wazuh_alerts" {
  targets = [
    {
      __path__ = "/var/log/wazuh/alerts.json",
      job      = "wazuh_alerts",
    },
  ]

  forward_to = [loki.write.local.receiver]

  tail_from_end = true
}



