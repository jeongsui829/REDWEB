services:

  prometheus:
    image: prom/prometheus:v3.15.0
    container_name: prometheus
    restart: unless-stopped
    network_mode: host

    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=15d"
      - "--storage.tsdb.retention.size=5GB"
      - "--web.listen-address=127.0.0.1:9090"

    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus


  node-exporter:
    image: prom/node-exporter:v1.12.1
    container_name: node-exporter
    restart: unless-stopped

    network_mode: host
    pid: host

    command:
      - "--path.rootfs=/host"
      - "--web.listen-address=127.0.0.1:9100"
      - '--collector.textfile.directory=/var/lib/node_exporter/textfile'

    volumes:
      - /:/host:ro,rslave
      - ./node-exporter/textfile:/var/lib/node_exporter/textfile:ro


  grafana:
    image: grafana/grafana:13.2.2
    container_name: grafana
    restart: unless-stopped

    network_mode: host

    environment:
      GF_SERVER_HTTP_ADDR: "0.0.0.0"
      GF_SERVER_HTTP_PORT: "3000"

      GF_SECURITY_ADMIN_USER: "admin"
      GF_SECURITY_ADMIN_PASSWORD: "REPLACE_LOCALLY"

      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"

    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro

  oracle-exporter:
    image: container-registry.oracle.com/database/observability-exporter:2.5.0
    container_name: oracle-exporter
    restart: unless-stopped

    network_mode: host

    environment:
      DB_USERNAME: REDWEB_MONITOR
      DB_PASSWORD: "REPLACE_LOCALLY"
      DB_CONNECT_STRING: "127.0.0.1:1521/FREEPDB1"
      CONFIG_FILE: "/config/exporter.yml"

    volumes:
      - ./oracle-exporter/exporter.yml:/config/exporter.yml:ro
  loki:
    image: grafana/loki:3.7.0
    container_name: loki
    restart: unless-stopped

    network_mode: host

    command:
      - "-config.file=/etc/loki/loki.yml"

    volumes:
      - ./loki/loki.yml:/etc/loki/loki.yml:ro
      - ./loki/data:/loki

    security_opt:
      - no-new-privileges:true

  alloy:
    image: grafana/alloy:v1.20.1
    container_name: alloy
    restart: unless-stopped

    network_mode: host
    user: "10002:${TOMCAT_GID}"

    command:
      - run
      - --server.http.listen-addr=127.0.0.1:12345
      - --storage.path=/var/lib/alloy
      - --disable-reporting
      - /etc/alloy/config.alloy

    volumes:
      - ./alloy/config.alloy:/etc/alloy/config.alloy:ro
      - ./alloy/data:/var/lib/alloy:rw
      - /opt/tomcat/logs:/var/log/tomcat:ro
      - /var/ossec/logs/alerts:/var/log/wazuh:ro

    security_opt:
      - no-new-privileges:true

    depends_on:
      - loki


  blackbox-exporter:
    image: quay.io/prometheus/blackbox-exporter:v0.27.0
    container_name: blackbox-exporter
    restart: unless-stopped
    network_mode: host
    command:
      - "--config.file=/etc/blackbox/blackbox.yml"
      - "--web.listen-address=127.0.0.1:9115"
    volumes:
      - ./blackbox/blackbox.yml:/etc/blackbox/blackbox.yml:ro

volumes:
  prometheus_data:
  grafana_data:

