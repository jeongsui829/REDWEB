+.hero-banner, .profile-hero { display: grid; grid-template-columns: minmax(0,1.3fr) minmax(0,.7fr); gap: 24px; padding: 28px; background: var(--color-accent); color: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
