+.section-card, .side-card, .toolbar-card { padding: var(--space-5); }
+.feature-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
+.feature-card { background: #fff; border: 1px solid var(--color-border); color: var(--color-text); }
+.list-row, .board-row, .admin-line { display: flex; justify-content: space-between; gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--color-border); overflow-wrap: anywhere; }
+.list-row:last-child, .board-row:last-child { border-bottom: 0; }
