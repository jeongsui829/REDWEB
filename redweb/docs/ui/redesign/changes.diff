+.page-top, .editor-card { padding: 28px; }
+.board-shell { display: flex; flex-direction: column; gap: 20px; }
+.board-shortcuts { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; background: #fff; }
+.shortcut-group { min-width: 0; }
+.shortcut-group .eyebrow { font-size: 10px; color: var(--color-muted); }
+.shortcut-links { display: flex; flex-wrap: wrap; gap: 6px; }
+.shortcut-links a { padding: 6px 9px; border-radius: 5px; color: var(--color-secondary); font-size: 12px; background: var(--color-subtle); border: 1px solid transparent; }
+.shortcut-links a:hover { border-color: var(--color-border); }
+.shortcut-links a.active { background: var(--color-primary-soft); color: var(--color-primary); border-color: #efccd0; font-weight: 700; }
+.board-hero { display: flex; justify-content: space-between; align-items: center; gap: 24px; border-left: 3px solid var(--color-primary); }
+.board-hero-copy { min-width: 0; max-width: 820px; }
+.board-hero-copy h1 { margin-bottom: 10px; font-size: 30px; }
+.board-hero-copy p { margin: 0; color: var(--color-muted); font-size: 14px; }
+.board-hero-copy .alert { margin-top: 16px; }
+.board-hero-actions { flex-shrink: 0; }
+.toolbar-grid { display: grid; grid-template-columns: minmax(0,1fr) 140px auto; align-items: center; gap: 10px; }
+.toolbar-grid input[name="keyword"] { width: 100%; }
+.toolbar-grid .btn { min-height: 43px; }
+.board-list-card { padding-block: 4px; }
+.list-table { gap: 0; }
+.board-row { display: grid; grid-template-columns: minmax(0,1fr) 240px; gap: 24px; align-items: center; padding: 22px 4px; }
+.board-row:hover { background: #fafbfc; }
+.board-row-main { min-width: 0; }
+.board-row-main strong { font-size: 16px; line-height: 1.6; }
+a.board-row:hover .title-line strong { color: var(--color-primary); }
+.board-row-main p { color: var(--color-muted); font-size: 13px; margin: 7px 0 0; line-height: 1.7; }
+.board-row-summary { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; max-height: 3.4em; overflow: hidden; overflow-wrap: anywhere; }
+.board-row-meta { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 5px 12px; min-width: 0; color: var(--color-muted); font-size: 12px; font-variant-numeric: tabular-nums; }
+.board-row-meta span:first-child { flex-basis: 100%; text-align: right; font-weight: 600; color: var(--color-secondary); }
+.board-row-meta span:nth-child(2) { flex-basis: 100%; text-align: right; }
+.list-table > div.board-row { display: block; padding: 40px 12px; text-align: center; background: transparent; }
+.faq-warning { display: flex; flex-direction: column; gap: 12px; }
+.faq-warning p { margin: 0; font-size: 14px; }
+.faq-question { color: var(--color-text); font-weight: 700; padding-top: 16px; border-top: 1px solid var(--color-border); }
+.faq-question:first-child { border: 0; padding-top: 0; }
+.faq-answer { color: var(--color-muted); padding-bottom: 8px; }
+.detail-shell { display: flex; flex-direction: column; gap: 24px; max-width: 1000px; }
+.detail-card { position: static; padding: 32px; }
+.detail-card h1 { font-size: clamp(25px,3vw,34px); }
+.detail-meta, .detail-actions { display: flex; gap: 8px 16px; flex-wrap: wrap; }
+.detail-meta { color: var(--color-muted); font-size: 13px; overflow-wrap: anywhere; }
+.user-menu-trigger { cursor: context-menu; font-weight: 650; color: var(--color-secondary); }
+.user-menu-trigger:hover { color: var(--color-primary); }
+.detail-content { margin-block: 28px; padding-top: 28px; border-top: 1px solid var(--color-border); line-height: 1.9; overflow-wrap: anywhere; min-width: 0; }
+.detail-content pre, .detail-content code, .rich-editor pre, .code-composer textarea { font-family: "Consolas", "Cascadia Code", monospace; }
+.detail-content pre, .rich-editor pre { overflow-x: auto; padding: 18px; border-radius: var(--radius-md); background: #202b3b; color: #e4eaf2; border: 1px solid #3a4658; }
+.detail-content table, .rich-editor table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 18px; background: #fff; }
+.detail-content th, .detail-content td, .rich-editor th, .rich-editor td { padding: 10px 14px; border: 1px solid var(--color-border); text-align: left; min-width: 100px; }
+.detail-content .formula, .rich-editor .formula { display: inline-block; padding: 4px 8px; border-radius: 4px; background: #edf1f6; color: var(--color-secondary); font-family: "Consolas", monospace; }
+.detail-content img, .editor-image img { max-width: 100%; height: auto; display: block; margin-block: 18px; border-radius: var(--radius-md); }
+.detail-card > .line-card { background: var(--color-subtle); }
+.detail-card > .line-card a { color: var(--color-secondary); text-decoration: underline; text-underline-offset: 3px; font-size: 14px; }
+.detail-actions { padding-top: 24px; margin-top: 24px; border-top: 1px solid var(--color-border); gap: 10px; }
+.comment-form { margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--color-border); }
+.reply-form { margin-top: 16px; }
+.reply-form[hidden], .code-composer[hidden], .color-palette[hidden] { display: none !important; }
+.comment-list { gap: 0; }
+.comment-item { border-radius: 0; padding: 20px 0; border-bottom: 1px solid var(--color-border); background: transparent; }
+.comment-item:last-child { border-bottom: 0; }
+.comment-child { margin-top: 16px; margin-left: 20px; padding: 16px; background: var(--color-subtle); border-left: 2px solid var(--color-border); }
