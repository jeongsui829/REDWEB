# Replace domain and measured session cap. Never store real DB credentials here.
CATALINA_OPTS="-Djava.io.tmpdir=/srv/redweb/scratch/tomcat/tmp -Xms256m -Xmx768m -Dredweb.secureCookie=true -Dredweb.upload.root=/var/lib/redweb/uploads -Dredweb.maxActiveSessions=MEASURED_POSITIVE_CAP"
REDWEB_PUBLIC_BASE_URL="https://REDWEB_TEST_HOST/scuredweb"
REDWEB_PUBLIC_REGISTRATION_ENABLED=false
REDWEB_REQUIRE_JNDI=true
REDWEB_ALLOW_LEGACY_PLAINTEXT_PASSWORDS=false
REDWEB_UPLOAD_QUOTA_BYTES=524288000
REDWEB_UPLOAD_MIN_FREE_BYTES=1073741824
REDWEB_UPLOAD_CONCURRENCY=2
