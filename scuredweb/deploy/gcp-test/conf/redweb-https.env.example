# Select this file only for the HTTPS Nginx path.
CATALINA_OPTS="-Xms256m -Xmx768m -Djava.awt.headless=true -Dredweb.secureCookie=true -Dredweb.upload.root=/var/lib/redweb/uploads"
REDWEB_PUBLIC_BASE_URL="https://REDWEB_TEST_HOST/scuredweb"

REDWEB_UPLOAD_QUOTA_BYTES=524288000
REDWEB_UPLOAD_MIN_FREE_BYTES=1073741824

# No email verification provider: keep public signup closed in production.
REDWEB_PUBLIC_REGISTRATION_ENABLED=false

REDWEB_REQUIRE_JNDI=true
REDWEB_ALLOW_LEGACY_PLAINTEXT_PASSWORDS=false
REDWEB_UPLOAD_CONCURRENCY=2
